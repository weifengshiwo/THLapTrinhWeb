@model GREEN_STORE.Models.Product
@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
}

<div class="container mt-4">
    <h2>Thông Tin Chi Tiết Sản Phẩm</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <h5>Ảnh đại diện:</h5>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Main Image" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover;" />
            }
            else
            {
                <p class="text-muted">Không có ảnh đại diện</p>
            }
        </div>
        <div class="col-md-8">
            <h4>Tên sản phẩm: <span class="text-primary">@Model.Name</span></h4>
            <p><strong>Giá bán:</strong> @Model.Price.ToString("C")</p>
            <p><strong>Mô tả chi tiết:</strong> @Model.Description</p>
        </div>
    </div>

    @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
    {
        <div class="mt-4">
            <h5>Các hình ảnh phụ liên quan:</h5>
            <div class="row">
                @foreach (var url in Model.ImageUrls)
                {
                    <div class="col-6 col-md-3 mb-2">
                        <img src="@url" alt="Sub Image" class="img-thumbnail" style="height: 150px; object-fit: cover;" />
                    </div>
                }
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a> |
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>